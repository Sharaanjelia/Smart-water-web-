APP_NAME="Smart Water Kota Payakumbuh"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/smart-water

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Database Configuration (MySQL Utama - Laragon / XAMPP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_water_payakumbuh
DB_USERNAME=root
DB_PASSWORD=

# Sesi, Cache, & File Storage
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Chatbot AI TirtaBot (Opsional / Fallback tersedia lokal)
# GEMINI_API_KEY=
